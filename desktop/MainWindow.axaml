<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kitten.Desktop.MainWindow"
        Width="1320" Height="860" MinWidth="960" MinHeight="620"
        Title="Kitten" Icon="avares://Kitten.Desktop/Assets/kitten.ico"
        Opened="OnOpened" KeyDown="WindowKeyDown">

  <!-- Three regions and a status line. Sessions on the left, the conversation in the middle, what the
       run produced on the right. Everything else — models, benchmarks, agents, workspace tools,
       exports — lives in the command palette (Ctrl+K) instead of a wall of buttons. -->
  <Panel>
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="252,*,344">

      <!-- Header -->
      <Border Grid.Row="0" Grid.ColumnSpan="3" Padding="14,9" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Text="Kitten" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
              <TextBlock Name="ProjectText" Text="No project" FontSize="11.5" Classes="muted" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="Open project" Click="OpenProject" Classes="tiny" />
            <Button Name="ContextButton" Content="Activity" Click="ToggleContextDrawer" Classes="tiny" ToolTip.Tip="Show activity, plan, and changes" />
            <Button Name="SettingsButton" Content="Settings" Click="ToggleSettings" Classes="tiny" />
            <Button Content="Commands  Ctrl+K" Click="ShowCommandPalette" Classes="tiny" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sessions -->
      <Border Grid.Row="1" Grid.Column="0" Padding="12" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Button Grid.Row="0" Content="New task" Click="NewTask" Classes="primary" HorizontalAlignment="Stretch" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,12,0,8">
            <TextBox Name="ConversationSearch" Watermark="Search" FontSize="12" Padding="8,5" />
            <Button Grid.Column="1" Content="Find" Click="SearchConversations" Classes="tiny" />
          </Grid>
          <!-- Sessions, grouped by the folder they work in. A project row and a session row used to
               render through the same template, so a folder name looked exactly like a task and the
               grouping was unreadable. They are now visibly different things: the folder is a quiet
               header with its path underneath, the session is an indented row with its own recency. -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ListBox Name="ConversationList" SelectionChanged="SelectConversation">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                    <!-- Project header: folder icon + name, and the path it actually points at. -->
                    <TextBlock Text="📁" FontSize="11" IsVisible="{Binding IsProject}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" IsVisible="{Binding IsProject}" Spacing="0">
                      <TextBlock Text="{Binding Display}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.45" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Session row: indented under its project, title + recency. -->
                    <TextBlock Grid.Column="1" IsVisible="{Binding IsSession}" Text="{Binding Display}"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Conversation -->
      <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto,Auto" Margin="20,16,20,14">
        <!-- Bottom-anchored, like a conversation: the newest turn sits next to the composer instead of
             stranding it under a screen of empty space. -->
        <ScrollViewer Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="TranscriptHost" VerticalAlignment="Bottom" />
        </ScrollViewer>

        <!-- An approval is a decision, so it belongs next to the conversation that raised it, not in a
             side panel. Hidden entirely until one is actually pending. -->
        <Border Name="ApprovalBar" Grid.Row="1" IsVisible="False" Margin="0,10,0,0" Padding="12,10"
                CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Name="ApprovalText" Text="" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Name="ApproveButton" Content="Approve" Click="ApproveAction" IsEnabled="False" Classes="primary tiny" />
              <Button Name="DenyButton" Content="Deny" Click="DenyAction" IsEnabled="False" Classes="tiny" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
          <!-- The mascot lives beside the composer, because that is where the eye already is while
               waiting for an answer — a 26px cat in the far side pane is easy to miss entirely. -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ContentControl Grid.Column="0" Name="MascotHost" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="Prompt" Watermark="What should Kitten do?"
                     AcceptsReturn="True" MinHeight="86" MaxHeight="220" TextWrapping="Wrap" KeyDown="PromptKeyDown" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <Button Grid.Column="0" Name="RunButton" Content="Run" Click="Submit" Classes="primary" />
            <Button Grid.Column="1" Name="CancelButton" Content="Stop" Click="CancelRun" IsEnabled="False" Margin="8,0,0,0" />
            <!-- The effort dial: fast → think hard. Persisted per conversation; the hint line explains
                 what the selected level buys (and costs). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
              <ToggleButton Name="EffortFast" Content="Fast" Classes="segment first" Click="EffortClicked" Tag="fast" />
              <ToggleButton Name="EffortBalanced" Content="Balanced" Classes="segment" Click="EffortClicked" Tag="balanced" IsChecked="True" />
              <ToggleButton Name="EffortCareful" Content="Careful" Classes="segment" Click="EffortClicked" Tag="careful" />
              <ToggleButton Name="EffortHard" Content="Think Hard" Classes="segment last" Click="EffortClicked" Tag="think-hard" />
            </StackPanel>
            <TextBlock Grid.Column="3" Name="ComposerHint" Text="" Classes="muted" FontSize="11.5" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="4" Name="PlanButton" Content="Plan first" Click="PlanAndRun" Classes="ghost" />
            <Button Grid.Column="5" Name="ImplementButton" Content="Implement plan" Click="ImplementPlan" IsEnabled="False" Classes="ghost" />
          </Grid>
        </StackPanel>
      </Grid>

      <!-- Who is working, and what came out of it. Every block here hides itself until it has
           something true to say: a panel full of "nothing yet" placeholders is noise that teaches
           people to stop reading it. -->
      <Border Name="ContextDrawer" Grid.Row="1" Grid.Column="2" Padding="14" Background="{DynamicResource SurfaceBrush}" IsVisible="False"
              BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <!-- The live surface: a ring that turns only while work is genuinely in flight, and one
                 row per worker (main model, sidecar, each subagent). Built in code by WorkPanel. -->
            <ContentControl Name="WorkHost" />

            <TextBlock Name="Activity" Text="" Classes="body" IsVisible="False" TextWrapping="Wrap" />
            <TextBlock Name="RunMeta" Text="" FontSize="11" Classes="muted" IsVisible="False" />
            <TextBlock Name="RouteLine" Text="" Classes="muted" FontSize="11.5" IsVisible="False" TextWrapping="Wrap" />
            <TextBlock Name="CurrentToolLine" Text="" Classes="muted" FontSize="11.5" IsVisible="False" TextTrimming="CharacterEllipsis" />

            <!-- The live plan: goal + contract summary + step list with statuses. -->
            <Border Name="PlanCard" IsVisible="False" Padding="10,9" CornerRadius="7" Background="{DynamicResource Surface2Brush}">
              <StackPanel Spacing="5">
                <TextBlock Name="PlanGoal" Text="" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Name="PlanContract" Text="" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Name="PlanSteps" Spacing="2" />
                <Button Name="PlanDetailButton" Content="Contract" Click="ShowCompiledContract" IsVisible="False" Classes="ghost tiny" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <TextBlock Name="VerificationLine" Text="" Classes="muted" FontSize="11.5" IsVisible="False" TextWrapping="Wrap" />

            <StackPanel Name="EvidenceSection" Spacing="5" IsVisible="False">
              <TextBlock Text="EVIDENCE" Classes="label" />
              <TextBlock Name="Evidence" Text="" Classes="body" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="RunChecksButton" Content="Run checks" Click="RunSuggestedChecks" IsEnabled="False" Classes="tiny" />
                <Button Name="CancelChecksButton" Content="Stop" Click="CancelSuggestedChecks" IsEnabled="False" Classes="tiny" />
              </StackPanel>
            </StackPanel>

            <StackPanel Name="ChangesSection" Spacing="5" IsVisible="False">
              <TextBlock Text="CHANGES" Classes="label" />
              <TextBlock Name="ChangesSummary" Text="" Classes="body" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Review diff" Click="OpenWorkspaceChanges" Classes="tiny" />
                <Button Content="Files" Click="OpenWorkspaceExplorer" Classes="tiny" />
              </StackPanel>
            </StackPanel>

            <!-- Run actions appear only once one of them can actually do something. -->
            <StackPanel Name="RunActions" Orientation="Horizontal" Spacing="6" IsVisible="False">
              <Button Name="UndoButton" Content="Undo" Click="UndoLastRun" IsEnabled="False" Classes="tiny" />
              <Button Name="RedoButton" Content="Redo" Click="RedoLastRun" IsEnabled="False" Classes="tiny" />
              <Button Name="ResumeButton" Content="Resume" Click="ResumeInterrupted" IsEnabled="False" Classes="tiny" />
              <Button Name="RetryRunButton" Content="Retry" Click="RetryFailedRun" IsEnabled="False" Classes="tiny" />
            </StackPanel>

            <!-- Only shown while a bakeoff is in flight or has a report to open. -->
            <StackPanel Name="BakeoffSection" Spacing="5" IsVisible="False">
              <TextBlock Text="MODEL BAKEOFF" Classes="label" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="CancelBakeoffButton" Content="Stop" Click="CancelModelBakeoff" IsEnabled="False" Classes="tiny" />
                <Button Name="ApplyBakeoffButton" Content="Apply winners" Click="ApplyModelBakeoff" IsEnabled="False" Classes="tiny" />
                <Button Name="ViewBakeoffReportButton" Content="Report" Click="ViewBakeoffReport" IsEnabled="False" Classes="tiny" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Settings. A place, not a pop-up: it takes the work area, keeps the header and status line
           visible, and its own left rail names the groups. Populated in code (SettingsView). -->
      <Border Name="SettingsHost" Grid.Row="1" Grid.ColumnSpan="3" IsVisible="False"
              Background="{DynamicResource BaseBrush}" />

      <!-- Status line -->
      <Border Grid.Row="2" Grid.ColumnSpan="3" Padding="14,6" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Name="ConnectionDot" Width="7" Height="7" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
            <TextBlock Name="ConnectionText" Text="Starting engine…" FontSize="11.5" Classes="muted" VerticalAlignment="Center" />
            <Button Name="RetryEngineButton" Content="Retry" Click="RetryEngine" IsEnabled="False" Classes="ghost tiny" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="·" Classes="muted" FontSize="11.5" Margin="8,0" VerticalAlignment="Center" />
          <!-- The model runtime, distinct from the engine pipe: is llama.cpp up, which model, what ctx. -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Name="RuntimeDot" Width="7" Height="7" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
            <TextBlock Name="RuntimeText" Text="model: checking…" FontSize="11.5" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
            <Button Name="RuntimeActionButton" Content="Start runtime" Click="StartRuntime" IsVisible="False" Classes="ghost tiny" />
            <Button Content="Runtime log" Click="ShowRuntimePanel" Classes="ghost tiny" />
          </StackPanel>
          <TextBlock Grid.Column="3" Text="·" Classes="muted" FontSize="11.5" Margin="8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Name="ModelText" Text="Models: checking…" FontSize="11.5" Classes="muted"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="5" Text="Ctrl+K   ·   Ctrl+Enter   ·   Esc" FontSize="10.5" Classes="muted"
                     Opacity="0.45" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <!-- Command palette overlay. Populated in code so every action has exactly one definition. -->
    <Border Name="PaletteOverlay" IsVisible="False" Background="#b8000000">
      <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" Width="620"
              Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
              BorderThickness="1" CornerRadius="10" Padding="10">
        <StackPanel Spacing="8">
          <TextBox Name="PaletteSearch" Watermark="Search commands…" FontSize="14" KeyDown="PaletteKeyDown" />
          <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <ListBox Name="PaletteList" DoubleTapped="PaletteInvoke" />
          </ScrollViewer>
          <TextBlock Text="Enter to run   ·   Esc to close" FontSize="11" Classes="muted" Opacity="0.7" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
