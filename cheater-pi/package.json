{
  "name": "@cheater/cheater-pi",
  "version": "0.7.0",
  "description": "Cheater distribution package for Pi.",
  "type": "module",
  "bin": {
    "cheater": "./dist/src/index.js",
    "kitten": "./dist/src/index.js"
  },
  "keywords": [
    "pi-package",
    "cheater",
    "coding-agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "kitten": "node dist/src/core/repl.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "typebox": "^1.3.1"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
