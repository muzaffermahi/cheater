{
  "name": "@cheater/cheater-pi",
  "version": "0.7.0",
  "description": "Kitten — a reliable local-first coding agent (terminal + web UI) for local models, with durable conversations and an adaptive reliability engine.",
  "type": "module",
  "bin": {
    "kitten": "./dist/src/core/kitten.js",
    "cheater": "./dist/src/index.js"
  },
  "keywords": [
    "kitten",
    "coding-agent",
    "local-first",
    "llm",
    "tui",
    "lm-studio",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Muzaffer Mahi Can",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzaffermahi/cheater.git"
  },
  "homepage": "https://github.com/muzaffermahi/cheater#readme",
  "bugs": {
    "url": "https://github.com/muzaffermahi/cheater/issues"
  },
  "files": [
    "dist",
    "src",
    "prompts",
    "skills",
    "themes",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "smoke": "node scripts/pack-smoke.mjs",
    "kitten": "node dist/src/core/kitten.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "typebox": "^1.3.1"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
